+  /**
+   * Remove earlier launches' Web sign-in cookies before signing in (Harness Studio patch). The Host names its
+   * cookie after its address, port included, and listens on a new port each launch, while cookies are kept per
+   * host name only; without this every launch adds one more 127.0.0.1 cookie for days, until requests carry so
+   * many that the Host refuses them (HTTP 431) and startup fails. Only the cookie the next sign-in sets is valid.
+   * @param url - the Host's launch URL.
+   */
+  const forgetStaleHostCookies = async (url: string): Promise<void> => {
+    const origin = new URL(url).origin
+    try {
+      const cookies = await session.defaultSession.cookies.get({ domain: new URL(url).hostname })
+      await Promise.all(cookies.filter(cookie => cookie.name.startsWith('dsh-auth-'))
+        .map(cookie => session.defaultSession.cookies.remove(origin, cookie.name)))
+    } catch (error) {
+      console.warn('dsh desktop: could not remove stale Host sign-in cookies', error)
+    }
   }
   const platformView = new DesktopPlatformView(join(app.getAppPath(), 'lib', 'preload-platform-account.cjs'),
