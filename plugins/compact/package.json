{
  "name": "@harness-studio/compact",
  "version": "0.2.0",
  "description": "A Claude-like feel for Harness Studio in Harness's own colours: denser spacing, serif replies, calmer chrome, and whole-app zoom with \u2318+ / \u2318\u2212 / \u23180.",
  "license": "MIT",
  "author": { "name": "Vignesh Murugan", "email": "Muruganvignesh0810@gmail.com", "url": "https://github.com/vigneshv1cky" },
  "homepage": "https://github.com/vigneshv1cky/harness-studio/tree/main/plugins/compact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshv1cky/harness-studio.git",
    "directory": "plugins/compact"
  },
  "bugs": "https://github.com/vigneshv1cky/harness-studio/issues",
  "type": "module",
  "keywords": [
    "harness-plugin",
    "harness-studio",
    "theme",
    "density",
    "zoom"
  ],
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "site-approval.js",
    "data.js",
    "computer-use.js",
    "default-instructions.js",
    "turn-guard.js",
    "cloud-logins.js",
    "studio-skills.js",
    "ffmpeg.js",
    "transcribe.js",
    "skills/*.md",
    "skills/*.html",
    "default-agents.md",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
