{
  "manifest_version": 3,
  "name": "Harness Studio Chrome bridge",
  "version": "0.5.1",
  "description": "Lets your AI agent (Harness Studio, or any MCP client) read and act in your Chrome tabs through a paired local bridge.",
  "homepage_url": "https://github.com/vigneshv1cky/harness-studio/tree/main/chrome-bridge",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Harness Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "select-element": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Select an element to send to Harness Studio"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
