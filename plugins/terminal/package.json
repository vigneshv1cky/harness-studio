  "license": "MIT",
  "author": "Vignesh Murugan",
  "homepage": "https://github.com/vigneshv1cky/harness-studio/tree/main/plugins/terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshv1cky/harness-studio.git",
    "directory": "plugins/terminal"
  },
  "bugs": "https://github.com/vigneshv1cky/harness-studio/issues",
  "type": "module",
  "keywords": ["harness-plugin", "harness-studio", "terminal", "pty"],
  "engines": { "dsh": ">=0.2.1-alpha.3 <0.3.0" },
  "exports": { ".": "./index.js" },
  "files": ["index.js", "screen.js", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test test/*.test.mjs" },
