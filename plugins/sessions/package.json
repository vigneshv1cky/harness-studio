{
  "name": "@harness-studio/sessions",
  "version": "0.1.0",
  "description": "Side sessions for Harness Studio, like Claude Code desktop's: the agent hands work to a separate session in the sidebar with a written brief, optionally in its own git worktree, asks first when the split is its own idea, and gets each turn's report back.",
  "license": "MIT",
  "author": "Vignesh Murugan",
  "homepage": "https://github.com/vigneshv1cky/harness-studio/tree/main/plugins/sessions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshv1cky/harness-studio.git",
    "directory": "plugins/sessions"
  },
  "bugs": "https://github.com/vigneshv1cky/harness-studio/issues",
  "type": "module",
  "keywords": [
    "harness-plugin",
    "harness-studio",
    "sessions",
    "worktree",
    "delegation"
  ],
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "logic.js",
    "process.js",
    "store.js",
    "worktree.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
