{
  "name": "@harness-studio/devpreview",
  "version": "0.1.0",
  "description": "Live preview of your app's dev server inside Harness Studio, with click-to-select so the agent knows exactly which element and source line you mean.",
  "license": "MIT",
  "author": { "name": "Vignesh Murugan", "email": "Muruganvignesh0810@gmail.com", "url": "https://github.com/vigneshv1cky" },
  "homepage": "https://github.com/vigneshv1cky/harness-studio/tree/main/plugins/devpreview#readme",
  "repository": { "type": "git", "url": "git+https://github.com/vigneshv1cky/harness-studio.git", "directory": "plugins/devpreview" },
  "bugs": "https://github.com/vigneshv1cky/harness-studio/issues",
  "type": "module",
  "keywords": ["harness-plugin", "harness-studio", "preview", "element-picker"],
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "git-helper.js", "browser-bridge.js", "board.js", "board-runtime.html", "dashboards.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
