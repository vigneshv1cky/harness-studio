# Copy to desktop/.env.signing (git ignores it) and fill in your own values. desktop/build-mac.sh then
# signs and notarises the app. Never commit the filled-in file or the .p8 key.

# Your "Developer ID Application" certificate in the login keychain, exactly as
#   security find-identity -v -p codesigning
# lists it, for example: Developer ID Application: Your Name (TEAMID1234)
HARNESS_STUDIO_SIGNING_IDENTITY=

# App Store Connect API key used for notarisation (Users and Access → Integrations → App Store Connect API).
# Path to the downloaded AuthKey_XXXXXXXXXX.p8 file; keep it outside this repository.
APPLE_API_KEY=
# The key's 10-character Key ID.
APPLE_API_KEY_ID=
# The Issuer ID shown above the keys list.
APPLE_API_ISSUER=
